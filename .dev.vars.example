# Local only. Use a random value of at least 32 characters.
AUTH_SECRET=change-this-local-secret-to-at-least-32-characters

# Comma-separated bootstrap admin emails.
ADMIN_EMAILS=admin@example.com

# Optional: enable real AI answers. Without this key, chatbot uses built-in demo FAQ.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional demo bank-transfer details.
BANK_NAME=MB Bank
BANK_ACCOUNT=0000000000
BANK_OWNER=MORYTORY DEMO
